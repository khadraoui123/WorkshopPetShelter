<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WorkshopPetShelter">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 4 placeholders: internal navigation only, so exported="false". -->
        <activity
            android:name=".AdminDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".UserDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- Phase 7 screens; Phase 8 adds readable labels for the recents screen. -->
        <activity
            android:name=".PetDetailsActivity"
            android:label="Détails de l'animal"
            android:exported="false" />

        <activity
            android:name=".AddPetActivity"
            android:label="Ajouter un animal"
            android:exported="false" />

    </application>

</manifest>
