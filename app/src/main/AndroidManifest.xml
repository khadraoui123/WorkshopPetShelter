<!-- E:\WorkshopPetShelter\app\src\main\AndroidManifest.xml -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WorkshopPetShelter">

        <!-- Level 1: the splash is the single LAUNCHER entry point. -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Still exported for explicit in-app navigation, but no longer a launcher. -->
        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <!-- Phase 4 placeholders: internal navigation only, so exported="false". -->
        <activity
            android:name=".AdminDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".UserDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- Forgot password: internal explicit intent only, so exported="false". -->
        <activity
            android:name=".ResetPasswordActivity"
            android:label="@string/title_reset_password"
            android:exported="false" />

        <!-- About: internal explicit intent only, so exported="false". -->
        <activity
            android:name=".AboutActivity"
            android:label="@string/title_about"
            android:exported="false" />

        <!-- Phase 7 screens; Phase 8 adds readable labels for the recents screen. -->
        <activity
            android:name=".PetDetailsActivity"
            android:label="@string/title_pet_details"
            android:exported="false" />

        <activity
            android:name=".AddPetActivity"
            android:label="@string/add_pet"
            android:exported="false" />

        <!-- Level 3: user-only profile. Internal explicit intent, so exported="false". -->
        <activity
            android:name=".ProfileActivity"
            android:label="@string/profile"
            android:exported="false" />

    </application>

</manifest>
